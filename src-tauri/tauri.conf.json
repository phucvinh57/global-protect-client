{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gp-client",
  "version": "0.1.0",
  "identifier": "com.npvinh.gp-client",
  "build": {
    "beforeDevCommand": "bun run dev:tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "gp-client",
        "width": 460,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:gp-client.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/gp-helper"],
    "linux": {
      "deb": {
        "depends": ["libopenconnect5", "vpnc-scripts"],
        "files": {
          "/usr/share/polkit-1/actions/com.npvinh.gp-client.policy": "polkit/com.npvinh.gp-client.policy"
        }
      }
    }
  }
}
